    function selectCompatibleTrait(
        bytes32 seed,
        uint256 layerIndex,
        uint256 activeMask
    ) internal pure returns (uint256 selectedGlobalId) {
        (uint256 start, uint256 count) = getLayerOffset(layerIndex);
        uint256 eligibleWeight = 0;

        for (uint256 i = 0; i < count; i++) {
            uint256 gId = start + i;
            if ((activeMask & (1 << gId)) == 0) {
                eligibleWeight += getTraitWeight(gId);
            }
        }

        require(eligibleWeight > 0, "No compatible trait");

        uint256 roll = uint256(keccak256(abi.encode(seed, layerIndex))) % eligibleWeight;
        for (uint256 i = 0; i < count; i++) {
            uint256 gId = start + i;
            if ((activeMask & (1 << gId)) == 0) {
                uint16 w = getTraitWeight(gId);
                if (roll < w) {
                    return gId;
                }
                roll -= w;
                selectedGlobalId = gId;
            }
        }
    }

    function getTraits(bytes32 seed) public pure returns (uint256[4] memory chosen) {
        uint256 activeMask = 0;
        for (uint256 l = 0; l < 4; l++) {
            uint256 gId = selectCompatibleTrait(seed, l, activeMask);
            chosen[l] = gId;
            activeMask |= getExclusionMask(gId);
        }
    }

